<?xml version="1.0" encoding="utf-8"?>
<Mod id="8d1f6b2e-5c3a-4e79-9b1d-a4c27f0e6d35" version="1">
  <Properties>
    <Name>Ascension: Roguelite Overhaul</Name>
    <Stability>Beta</Stability>
    <Teaser>Every game becomes a roguelite run: drafts, events, Warlords, a Champion and permanent Legacy.</Teaser>
    <Description>Turns every game of Civilization V into a roguelite run. Draft Boons from rarity-tiered cards, make FTL-style choices in 30 random events, survive escalating Horde raids, hunt eight Era Warlords with your ever-evolving Champion, chase Bounties and unlock Synergies. Earn Legacy that persists between games to buy permanent upgrades and Origins, then climb 10 Ascension difficulty levels. Requires Brave New World. Single player only.</Description>
    <Authors>Ascension Roguelite contributors</Authors>
    <SpecialThanks>The Civ V modding community</SpecialThanks>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>1</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>0</SupportsMultiplayer>
    <SupportsHotSeat>0</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>0</ReloadAudioSystem>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
  </Properties>
